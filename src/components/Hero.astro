---
// src/components/Hero.astro — haut de page commun (photo + titre + boutons + bandeau).
// Utilisation :
//   <Hero h1="DJ Mariage à Lyon et Besançon" image="/images/mariage-hero.webp"
//         intro="Texte long (tablette / ordinateur)" introCourt="Texte court (mobile)">
//     Un mariage, vos choix<br /><span class="or">votre ambiance</span>
//   </Hero>
// Le texte entre les balises = la grande phrase. <span class="or"> la met en doré.
import Bandeau from './Bandeau.astro';
import { site } from '../data/site';

interface Props {
  h1: string;
  image: string;
  intro: string;
  introCourt?: string;      // si absent, le texte long s'affiche aussi sur mobile
  position?: string;        // cadrage de la photo sur ordinateur (ex. 'center top')
  positionMobile?: string;  // cadrage sur mobile / tablette
  variante?: 'accueil' | 'page';
  zone?: 'departements' | 'lyon' | 'besancon' | 'ain'; // barre « J'interviens… »
}
const { h1, image, intro, introCourt, position = 'center', positionMobile = 'center', variante = 'page', zone = 'departements' } = Astro.props;
---
<section class={`hero ${variante}`} style={`--img: url('${image}'); --pos: ${position}; --pos-m: ${positionMobile};`}>
  <div class="container hero-txt">
    <div class="h1-ligne">
      <span class="trait" aria-hidden="true"></span>
      <h1>{h1}</h1>
    </div>
    <p class="accroche"><slot /></p>
    <p class="intro">
      {introCourt ? (
        <><span class="long">{intro}</span><span class="court">{introCourt}</span></>
      ) : intro}
    </p>
    <div class="boutons" data-hero-cta>
      <a class="btn btn-dark" href="/devis">DISCUTER DE VOTRE PROJET</a>
      <a class="btn btn-light" href={site.telLien}>{site.telAffiche}</a>
    </div>
    <span class="fin-trait" aria-hidden="true"></span>
  </div>
  <Bandeau zone={zone} />
</section>

<style>
  .hero {
    color: #fff;
    background:
      linear-gradient(180deg, rgba(20,15,10,.55) 0%, rgba(20,15,10,.75) 60%, rgba(20,15,10,.9) 100%),
      var(--img) var(--pos-m) / cover no-repeat, #140f0a;
  }
  /* Toutes les pages ont la même trame (titre doré, phrase sur 2 lignes, texte, boutons)
     donc la même hauteur et le titre doré toujours au même endroit. */
  .hero-txt { padding-top: 24px; padding-bottom: 22px; }
  .h1-ligne { display: flex; align-items: center; gap: 12px; }
  .trait { width: 32px; height: 1px; background: var(--gold); flex-shrink: 0; }
  h1 { font-size: 20px; color: var(--gold); line-height: 1.2; }
  .accroche { margin-top: 16px; font-family: var(--serif); font-size: 36px; line-height: 1.05; }
  .accroche :global(.or) { color: var(--gold); }
  /* Variantes de retours à la ligne : <span class="l-mobile"> / <span class="l-large"> */
  .accroche :global(.l-large) { display: none; }
  /* min-height = nombre de lignes réservées : toutes les pages gardent la même hauteur
     même si le texte est un peu plus court (1 ligne mobile, 3 tablette, 2 ordinateur). */
  .intro { margin-top: 16px; font-size: 16px; line-height: 1.6; min-height: 1.6em; color: rgba(255,255,255,.92); }
  .long { display: none; }
  .fin-trait { display: none; }
  .boutons { margin-top: 18px; display: flex; flex-direction: column; gap: 10px; }

  /* --- Tablette --- */
  @media (min-width: 768px) {
    .hero {
      background:
        linear-gradient(90deg, rgba(20,15,10,.9) 0%, rgba(20,15,10,.7) 55%, rgba(20,15,10,.45) 100%),
        var(--img) var(--pos-m) / cover no-repeat, #140f0a;
    }
    .hero-txt { padding-top: 72px; padding-bottom: 40px; }
    .hero-txt > * { max-width: 600px; }
    h1 { font-size: 22px; }
    .trait { width: 48px; }
    .accroche { margin-top: 24px; font-size: 48px; }
    .accroche :global(.l-large) { display: inline; }
    .accroche :global(.l-mobile) { display: none; }
    .intro { margin-top: 24px; font-size: 17px; min-height: 4.8em; }
    .long { display: inline; } .court { display: none; }
    .boutons { margin-top: 32px; flex-direction: row; flex-wrap: wrap; gap: 16px; }
  }

  /* --- Ordinateur --- */
  @media (min-width: 1200px) {
    .hero {
      background:
        linear-gradient(90deg, rgba(18,13,9,.82) 0%, rgba(18,13,9,.55) 40%, rgba(18,13,9,.15) 70%, rgba(18,13,9,.3) 100%),
        var(--img) var(--pos) / cover no-repeat, #120d09;
    }
    .hero-txt { padding-top: 88px; padding-bottom: 56px; }
    .hero-txt > * { max-width: 820px; }
    h1 { font-size: 30px; }
    .trait { width: 66px; }
    .accroche { font-size: 58px; max-width: 640px; }
    .intro { margin-top: 28px; font-size: 18px; max-width: 560px; min-height: 3.2em; }
    .accueil .intro { max-width: 760px; }
    .boutons { margin-top: 40px; gap: 20px; }
    .fin-trait { display: block; margin-top: 20px; width: 66px; height: 1px; background: rgba(255,255,255,.6); }
  }
</style>
