---
// src/components/Bandeau.astro — chiffres clés + zones, en bas du haut de page.
const chiffres: { haut: string; bas: string; basLarge?: string; ico: string }[] = [
  { haut: 'Depuis 2019', bas: 'DJ-animateur', ico: 'casque' },
  { haut: 'UCPA', bas: 'Formation DJ', ico: 'diplome' },
  { haut: '+320', bas: 'Événements', basLarge: 'Événements réalisés', ico: 'etoile' },
  { haut: '+60', bas: 'Mariages', ico: 'coeur' },
];
// Zone affichée dans la barre « J'interviens… » : départements par défaut,
// grandes villes sur les pages DJ mariage Lyon / Besançon.
interface Props { zone?: 'departements' | 'lyon' | 'besancon' | 'ain' }
const { zone = 'departements' } = Astro.props;
const ZONES = {
  departements: { label: 'J’INTERVIENS DANS LE', liste: ['Rhône', 'Ain', 'Isère', 'Drôme'], fin: 'départements voisins' },
  lyon: { label: 'J’INTERVIENS À', liste: ['Lyon', 'Villeurbanne', 'Villefranche-sur-Saône', 'Vienne'], fin: 'toute la métropole' },
  besancon: { label: 'J’INTERVIENS À', liste: ['Besançon', 'École-Valentin', 'Ornans', 'Baume-les-Dames'], fin: 'tout le Doubs' },
  ain: { label: 'J’INTERVIENS À', liste: ['Miribel', 'Montluel', 'Meximieux', 'Trévoux'], fin: 'tout l’Ain' },
};
const z = ZONES[zone];
const zones = z.liste;
const icones: Record<string, string> = {
  casque: '<path d="M3 14v-2a9 9 0 0 1 18 0v2"/><path d="M21 15a2 2 0 0 1-2 2h-1v-6h1a2 2 0 0 1 2 2zM3 15a2 2 0 0 0 2 2h1v-6H5a2 2 0 0 0-2 2z"/>',
  diplome: '<path d="M2 9.5 12 4.5l10 5-10 5z"/><path d="M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5"/><path d="M22 9.5V15"/>',
  etoile: '<path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.4l6.2-.9z"/>',
  coeur: '<path d="M12 20.5s-8-5.2-8-10.7a4.5 4.5 0 0 1 8-2.8 4.5 4.5 0 0 1 8 2.8c0 5.5-8 10.7-8 10.7z"/>',
};
---
<div class="bandeau">
  <div class="container chiffres">
    {chiffres.map((c) => (
      <div class="chiffre">
        <span class="rond"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icones[c.ico]} /></span>
        <span class="txt">{c.haut}<small>{c.basLarge ? <><span class="court">{c.bas}</span><span class="large">{c.basLarge}</span></> : c.bas}</small></span>
      </div>
    ))}
  </div>
  <div class="zones">
    <div class="zones-in">
    <span class="label"><i class="ligne" aria-hidden="true"></i>{z.label}<i class="ligne m" aria-hidden="true"></i></span>
    <span class="liste">{zones.map((z, i) => <><i class={i === 0 ? 'sep premier' : 'sep'} aria-hidden="true"></i><b>{z}</b></>)}<span class="voisins"><span class="court">et</span><span class="large">Et</span> {z.fin}</span></span>
    <i class="ligne d-fin" aria-hidden="true"></i>
    </div>
  </div>
</div>

<style>
  .bandeau { background: linear-gradient(180deg, rgba(18,13,9,.4) 0%, rgba(18,13,9,.85) 100%); color: #fff; }
  .chiffres { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding-top: 14px; padding-bottom: 16px; border-top: 1px solid rgba(219,167,100,.35); }
  .chiffre { display: flex; align-items: center; gap: 10px; }
  .rond { width: 40px; height: 40px; flex-shrink: 0; border: 1px solid var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .txt { font-size: 16px; line-height: 1.2; display: flex; flex-direction: column; }
  .txt small { font-size: 13px; color: rgba(255,255,255,.85); }
  .zones { background: #2b2723; padding: 14px var(--gutter); }
  /* Même hauteur sur toutes les pages, qu'on affiche 4 départements ou 4 villes (noms plus longs) */
  .zones-in { min-height: 108px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-align: center; }
  .label { display: flex; align-items: center; gap: 12px; font-size: 11px; letter-spacing: 1.5px; color: var(--gold); }
  .ligne { display: block; width: 28px; height: 1px; background: var(--gold); flex-shrink: 0; }
  .d-fin { display: none; }
  .liste { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 4px 14px; font-size: 16px; }
  .liste b { font-weight: 400; }
  .sep::before { content: '·'; font-style: normal; color: var(--gold); }
  .sep.premier { display: none; } /* mobile : pas de trait avant le 1er département */
  .voisins { width: 100%; font-size: 13px; color: rgba(255,255,255,.75); }
  @media (min-width: 1200px) { .sep.premier { display: inline; } }
  .large { display: none; }

  @media (min-width: 1200px) {
    .chiffres { grid-template-columns: repeat(4, minmax(0, 1fr)); padding-top: 24px; padding-bottom: 24px; border-top: 0; }
    .chiffre { justify-content: center; gap: 16px; padding: 12px 16px; border-right: 1px solid var(--gold); }
    .chiffre:last-child { border-right: 0; }
    .rond { width: 52px; height: 52px; }
    .txt { font-size: 20px; line-height: 1.3; }
    .txt small { font-size: 20px; color: #fff; }
    .court { display: none; } .large { display: inline; }
    .zones { padding: 0; }
    .zones-in { max-width: 1440px; margin: 0 auto; flex-direction: row; justify-content: space-between; gap: 24px; height: 56px; min-height: 0; padding: 0 100px; }
    .label { gap: 24px; }
    .ligne { width: 66px; }
    .ligne.m { display: none; }
    .d-fin { display: block; }
    .liste { flex: 1; flex-wrap: nowrap; justify-content: space-between; gap: 24px; font-size: 18px; }
    .sep::before { content: '|'; }
    .liste { padding-left: 0; }
    .voisins { width: auto; font-size: 18px; color: #fff; }
    .voisins::before { content: '|'; color: var(--gold); margin-right: 24px; }
  }
  @media (min-width: 768px) and (max-width: 1199px) {
    .chiffres { gap: 0; padding-top: 8px; padding-bottom: 32px; border-top: 0; }
    .chiffre { gap: 16px; padding: 22px 20px 22px 0; }
    .chiffre:nth-child(odd) { border-right: 1px solid rgba(219,167,100,.6); }
    .chiffre:nth-child(even) { padding-left: 24px; }
    .chiffre:nth-child(-n+2) { border-bottom: 1px solid rgba(219,167,100,.35); }
    .chiffre:nth-child(n+3) { padding-bottom: 0; }
    .rond { width: 48px; height: 48px; }
    .txt { font-size: 19px; line-height: 1.3; }
    .txt small { font-size: 16px; }
    .zones { padding-top: 18px; padding-bottom: 18px; }
    .zones-in { min-height: 64px; flex-direction: row; flex-wrap: wrap; justify-content: center; align-content: center; gap: 8px 16px; }
    .label { width: 100%; justify-content: center; }
    .ligne { display: none; }
    .liste { gap: 10px 14px; font-size: 16px; }
    .sep::before { content: '|'; }
    .voisins { width: auto; font-size: 16px; color: #fff; }
    .voisins::before { content: '|'; color: var(--gold); margin-right: 14px; }
    .court { display: none; } .large { display: inline; }
  }
</style>
