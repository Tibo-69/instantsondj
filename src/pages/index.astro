---
// src/pages/index.astro — la page d'Accueil (adresse : /)
// Elle assemble : haut de page + bandeau, prestations, à propos,
// avis, FAQ générale et bloc devis. Header et footer viennent du Layout.
import Layout from '../layouts/Layout.astro';
import Bandeau from '../components/Bandeau.astro';
import Avis from '../components/Avis.astro';
import Faq from '../components/Faq.astro';
import CtaDevis from '../components/CtaDevis.astro';
import { faqGenerale } from '../data/faq';
import { site } from '../data/site';

const prestations = [
  { titre: 'Mariage', texte: 'Une ambiance romantique et festive pour le plus beau jour de votre vie.', img: '/images/carte-mariage.jpg', alt: 'Salle de réception dressée pour un mariage', href: '/dj-mariage' },
  { titre: 'Anniversaire', texte: 'Faites de votre anniversaire un moment magique et inoubliable.', img: '/images/carte-anniversaire.jpg', alt: 'Piste de danse pendant un anniversaire', href: '/dj-anniversaire' },
  { titre: 'Événements et soirées', texte: 'Séminaire, soirée d’entreprise ou fête privée : une ambiance musicale sur mesure.', img: '/images/carte-evenements.jpg', alt: 'Tiako aux platines lors d’une soirée d’entreprise', href: '/dj-evenementiel' },
];
---
<Layout
  title="DJ Tiako | DJ mariage et événementiel à Lyon et Besançon"
  description="DJ mariage et événementiel à Lyon, Besançon et alentours. Sets sur mesure, sonorisation et éclairage pour vos mariages, anniversaires et soirées. Devis rapide."
  page="accueil"
>
  <!-- ===== Haut de page ===== -->
  <section class="hero">
    <div class="container hero-txt">
      <div class="h1-ligne">
        <span class="trait" aria-hidden="true"></span>
        <h1>DJ Mariage &amp; Événementiel</h1>
      </div>
      <p class="accroche">Parce que chaque <span class="or">moment mérite</span> la bonne musique</p>
      <p class="intro">
        <span class="long">Des sets sur mesure, une ambiance unique et des souvenirs inoubliables pour vos mariages, anniversaires et tous vos événements privés ou professionnels.</span>
        <span class="court">Des sets sur mesure, une ambiance unique.</span>
      </p>
      <div class="boutons" data-hero-cta>
        <a class="btn btn-dark" href="/devis">DISCUTER DE VOTRE PROJET</a>
        <a class="btn btn-light" href={site.telLien}>{site.telAffiche}</a>
      </div>
    </div>
    <Bandeau />
  </section>

  <!-- ===== Mes prestations ===== -->
  <section class="section bg-cream">
    <div class="container presta">
      <div class="tete">
        <span class="eyebrow center">Mes prestations</span>
        <h2 class="h2">Des ambiances uniques pour tous vos événements</h2>
        <p>Que ce soit un mariage, un anniversaire ou un événement d’entreprise, je vous propose une prestation sur mesure adaptée à vos envies et à votre public.</p>
      </div>
      <div class="cartes">
        {prestations.map((p) => (
          <article class="carte">
            <img src={p.img} alt={p.alt} loading="lazy" width="600" height="400" />
            <div class="corps">
              <h3>{p.titre}</h3>
              <p>{p.texte}</p>
              <a class="link-arrow" href={p.href}>EN SAVOIR PLUS <span aria-hidden="true">⟶</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== À propos ===== -->
  <section class="section">
    <div class="container apropos">
      <div class="arche">
        <span class="fond" aria-hidden="true"></span>
        <img src="/images/portrait-tiako.png" alt="Portrait de DJ Tiako tenant son casque" loading="lazy" />
      </div>
      <div class="ap-txt">
        <span class="eyebrow">À propos</span>
        <h2 class="ap-titre">DJ Tiako, plus qu’un son,<br />un souvenir</h2>
        <p>DJ et animateur basé à Villeurbanne, j’accompagne les mariages, anniversaires et événements avec une approche musicale, technique et personnalisée.</p>
        <p>J’interviens dans toute la région lyonnaise et autour de Besançon, dans le Doubs, pour vos mariages, anniversaires et événements professionnels.</p>
        <a class="btn btn-dark" href="/a-propos">EN SAVOIR PLUS SUR TIAKO</a>
      </div>
    </div>
  </section>

  <Avis liste="general" />
  <Faq questions={faqGenerale} />
  <CtaDevis />
</Layout>

<style>
  /* --- Haut de page --- */
  .hero {
    color: #fff;
    background:
      linear-gradient(180deg, rgba(10,8,6,.55) 0%, rgba(10,8,6,.75) 60%, rgba(10,8,6,.9) 100%),
      url('/images/hero-accueil.jpg') 50% top / cover no-repeat, #120d09;
  }
  .hero-txt { padding-top: 24px; padding-bottom: 22px; }
  .h1-ligne { display: flex; align-items: center; gap: 12px; }
  .trait { width: 32px; height: 1px; background: var(--gold); flex-shrink: 0; }
  h1 { font-size: 20px; color: var(--gold); line-height: 1.2; }
  .accroche { margin-top: 16px; font-family: var(--serif); font-size: 32px; line-height: 1.05; }
  .or { color: var(--gold); }
  .intro { margin-top: 16px; font-size: 16px; color: rgba(255,255,255,.92); }
  .long { display: none; }
  .boutons { margin-top: 18px; display: flex; flex-direction: column; gap: 10px; }

  /* --- Prestations --- */
  .presta { display: flex; flex-direction: column; gap: 32px; }
  .tete { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .tete p { max-width: 760px; font-size: 16px; color: var(--text); }
  .cartes { display: grid; gap: 20px; }
  .carte { background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; transition: box-shadow .2s; }
  .carte:hover { box-shadow: 0 18px 40px rgba(17,17,17,.08); }
  .carte img { width: 100%; height: 190px; object-fit: cover; }
  .corps { padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .corps h3 { font-size: 28px; }
  .corps p { font-size: 14px; line-height: 1.5; color: #5e5e5e; }

  /* --- À propos --- */
  .apropos { display: flex; flex-direction: column; gap: 32px; }
  .arche { position: relative; height: 360px; display: flex; justify-content: center; align-items: flex-end; }
  .fond { position: absolute; bottom: 0; left: 50%; width: 260px; height: 300px; margin-left: -130px; border-radius: 130px 130px 0 0; background: var(--cream-2); border: 1px solid var(--gold); border-bottom: 0; }
  .arche img { position: relative; width: 260px; }
  .ap-txt { display: flex; flex-direction: column; gap: 16px; }
  .ap-titre { font-size: 32px; line-height: 1.12; }
  .ap-txt p { font-size: 16px; line-height: 1.7; color: var(--text); }

  /* --- Tablette --- */
  @media (min-width: 768px) {
    .hero-txt { max-width: 680px; margin-left: 0; padding-top: 72px; padding-bottom: 40px; }
    h1 { font-size: 22px; }
    .trait { width: 48px; }
    .accroche { margin-top: 24px; font-size: 48px; }
    .intro { margin-top: 24px; font-size: 17px; }
    .long { display: inline; } .court { display: none; }
    .boutons { margin-top: 32px; flex-direction: row; flex-wrap: wrap; gap: 16px; }
    .cartes { grid-template-columns: 1fr; }
    .carte { display: grid; grid-template-columns: 280px minmax(0, 1fr); }
    .carte img { height: 100%; min-height: 200px; }
    .corps { padding: 32px; justify-content: center; }
    .apropos { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 40px; align-items: center; }
    .arche { height: 380px; }
    .fond { width: 280px; height: 320px; margin-left: -140px; border-radius: 140px 140px 0 0; }
    .arche img { width: 280px; }
    .ap-titre { font-size: 36px; }
  }

  /* --- Ordinateur --- */
  @media (min-width: 1200px) {
    .hero {
      background:
        linear-gradient(90deg, rgba(18,13,9,.85) 0%, rgba(18,13,9,.55) 40%, rgba(18,13,9,.15) 70%, rgba(18,13,9,.3) 100%),
        url('/images/hero-accueil.jpg') center top / cover no-repeat, #120d09;
    }
    .hero-txt { max-width: 900px; padding-top: 88px; padding-bottom: 56px; }
    h1 { font-size: 30px; }
    .trait { width: 66px; }
    .accroche { font-size: 58px; max-width: 560px; }
    .intro { margin-top: 28px; font-size: 18px; max-width: 760px; }
    .boutons { margin-top: 28px; gap: 20px; }
    .presta { gap: 40px; }
    .tete p { font-size: 18px; }
    .cartes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
    .carte { display: block; }
    .carte img { height: 205px; min-height: 0; }
    .corps h3 { font-size: 34px; }
    .corps { padding: 32px; }
    .apropos { grid-template-columns: 560px minmax(0, 1fr); gap: 96px; }
    .arche { height: 580px; }
    .fond { width: 440px; height: 500px; margin-left: -220px; border-radius: 220px 220px 0 0; }
    .arche img { width: 440px; }
    .ap-txt { gap: 20px; }
    .ap-titre { font-size: 44px; }
    .ap-txt p { font-size: 18px; }
    .ap-txt .btn { align-self: flex-start; }
  }
</style>
