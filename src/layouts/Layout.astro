---
// src/layouts/Layout.astro — le squelette commun à toutes les pages.
// Chaque page l'utilise comme ceci :
//   <Layout title="..." description="..."> contenu de la page </Layout>
// Il s'occupe du <head> (SEO, polices, partage) + header + footer.

// Polices hébergées sur le site (plus rapide et conforme RGPD)
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';
import '../styles/global.css';
// Les 2 polices les plus utilisées sont préchargées (le texte s'affiche plus vite)
import sg400 from '@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-400-normal.woff2?url';
import cg400 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarreMobile from '../components/BarreMobile.astro';

interface Props {
  title: string;          // balise <title> (≈ 60 caractères max)
  description: string;    // meta description (≈ 155 caractères max)
  page?: string;          // page active dans le menu : 'mariage', 'tarifs'…
  noindex?: boolean;      // true pour la page 404
  preload?: string;       // grande image du haut de page, chargée en priorité
}
const { title, description, page = '', noindex = false, preload } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="preload" href={sg400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cg400} as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" href={preload} as="image" fetchpriority="high" />}
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Aperçu de partage (WhatsApp, Facebook…) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#141110" />
  </head>
  <body>
    <Header page={page} />
    <main>
      <slot />
    </main>
    <Footer />
    <BarreMobile />
  </body>
</html>
